# Stripe / payments — placeholder names only. Copy to `.env.local` (Next)
# and `workers/payments/.dev.vars` (Worker). Never commit real secrets.

# --- Next.js static site (baked in at build time) ---
# Payments Worker base URL (no trailing slash), e.g. http://127.0.0.1:8787
NEXT_PUBLIC_PAYMENTS_API_URL=

# Approved retail EUR price per guest (€149) — must match Worker BOOKING_PRICE_PER_GUEST_EUR.
NEXT_PUBLIC_BOOKING_PRICE_PER_GUEST_EUR=149

# Optional: Stripe publishable key (pk_test_...). Hosted Checkout does not require
# it on the client; document for future Elements / Payment Request Button use.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Cloudflare Worker secrets (use wrangler secret / .dev.vars — not Next) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# BOOKING_PRICE_PER_GUEST_EUR=149
